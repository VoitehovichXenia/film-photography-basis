---
import type { SectionProps } from './section.types';
import './section.scss';

const { id, step, stepText, title, titleAccent = '', epigraph, contentClassName } = Astro.props as SectionProps;

const titleAccentHTML = titleAccent ? `<span class="section__title-accent">${titleAccent}</span>` : '';
const titleHTML = title.replace(titleAccent, titleAccentHTML);
---

<section class="section" id={id}>
  <div class="section__header">
    <div class="section__title-container">
      <p class="section__step">{`${step}`.padStart(2, '0')} - {stepText}</p>

      <h2 class="section__title" set:html={titleHTML} />
    </div>

    <p class="section__epigraph">
      {epigraph}
    </p>
  </div>

  <div class:list={['section__content-container', contentClassName]}>
    <slot name="content" />
  </div>
</section>
