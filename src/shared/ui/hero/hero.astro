---
import { Image, Picture } from 'astro:assets';
import type { HeroProps } from './hero.types';
import './hero.scss';

const { title, titleAccent, description, image, subtitle } = Astro.props as HeroProps;

const titleText = titleAccent
  ? title.replace(titleAccent, `<span class="hero-accent">${titleAccent}</span>`)
  : title;
---

<div class="hero" data-hero>
  <Image
    {...image}
    alt="Blur placehoder"
    width={30}
    quality={20}
    format="avif"
    aria-hidden="true"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="hero__background-image blur-image"
  />
  <Picture
    src={image.src}
    alt={image.alt}
    formats={['avif']}
    widths={[ 600, 960, 1280, 1600, 1920, 2240 ]}
    sizes="100vw"
    quality={68}
    loading="eager"
    fetchpriority="high"
    decoding="sync"
    data-hero-main
    class="hero__background-image main-image"
  />
  <div class="hero__container">
    <div class="hero__content-block">
      <h2 class="hero__subtitle">
        {subtitle}
      </h2>

      <h1 class="hero__title" set:html={titleText} />

      <p class="hero__description">
        {description}
      </p>

      <div class="hero__cta-container">
        <slot name="cta" />
      </div>
    </div>
  </div>
  <div class="hero__side-block">
    <slot name="side-image" />
  </div>
</div>

<script>
  const heroElement = document.querySelector('.hero[data-hero]');
  const mainImage: HTMLImageElement | null |undefined = heroElement?.querySelector('img[data-hero-main]');

  const markHeroReady = () => {
    heroElement?.classList.add('hero_image-ready');
  }

  if (mainImage) {
    if (mainImage.complete) {
      markHeroReady();
    } else {
      mainImage.addEventListener('load', markHeroReady, { once: true });
      mainImage.addEventListener('error', markHeroReady, { once: true });
    }
  }
</script>
