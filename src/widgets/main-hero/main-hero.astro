---
import Hero from '@ui/hero/hero.astro';
import Cta from '@ui/cta/cta.astro';

import { heroContent } from '@content/hero';

const  { cta, ...hero } = heroContent
---

<Hero {...hero}>
  {cta?.map((item) => (
    <Cta slot="cta" id={item.id} text={item.text} url={item.url} kind={item.kind} />
  ))}
</Hero>
