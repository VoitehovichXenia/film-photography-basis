---
import { Section } from '@ui/section';
import { CardGrid, StarterKitCard, NavCard } from '@ui/card';
import './get-started-section.scss';

import { getStartedSectionContent as getStartedSection } from '@content/get-started-section';
const { section, starterKit, navCards } = getStartedSection;
---

<Section {...section} contentClassName="get-started-section">
  {
    starterKit?.length && (
      <CardGrid
        slot="content"
        columns={{ md: getStartedSection.starterKit?.length, base: 1 }}
        colGap={{ lg: "2px" }}
        rowGap={{ base: "4px" }}
        chooseActiveCard
        activeClassName="sk-card--active"
        defaultActiveCardIndex={0}
      >
        {getStartedSection.starterKit?.map((item) => (<StarterKitCard {...item} />))}
      </CardGrid>
    )
  }
  {
    navCards?.length && (
      <CardGrid slot="content"
        columns={{ lg: getStartedSection.navCards.length, md: 3, sm: 2, base: 1 }}
        colGap={{ base: "2px" }}
        rowGap={{ base: "4px" }}
      >
        {getStartedSection.navCards.map((item) => (<NavCard {...item} />))}
      </CardGrid>
    )
  }
</Section>
