---
import { Section } from '@ui/section';
import CardGrid from '@ui/card-grid/card-grid.astro';
import StarterKitCard from '@ui/card/starter-kit-card/starter-kit-card.astro';
import NavCard from '@ui/card/nav-card/nav-card.astro';

import { getStartedSectionContent as getStartedSection } from '@content/get-started-section';
const { section, starterKit, navCards } = getStartedSection;
---

<Section {...section}>
  {
    starterKit?.length && (
      <CardGrid
        slot="content"
        columns={{ base: getStartedSection.starterKit?.length }}
        colGap="2px"
      >
        {getStartedSection.starterKit?.map((item) => (
          <StarterKitCard
            title={item.title}
            pretitle={item.pretitle}
            description={item.description}
          />
        ))}
      </CardGrid>
    )
  }
  {
    navCards?.length && (
      <CardGrid slot="content" columns={{ base: getStartedSection.navCards.length }} colGap="2px">
        {getStartedSection.navCards.map((item) => (
          <NavCard title={item.title} pretitle={item.pretitle} url={item.url} />
        ))}
      </CardGrid>
    )
  }
</Section>
