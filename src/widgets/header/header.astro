---
import { headerContent } from '@content/header';
import { Cta } from '@ui/cta';
import './header.scss';
---

<header class="header">
  <div class="nav-container">
    <button class="nav-logo" id="nav-logo">{headerContent.logo}</button>
    <nav class="nav-menu">
      <ul class="nav-links">
        {
          headerContent.navLinks.map((link) => (
            <li class="nav-link">
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <Cta {...headerContent.cta} className="menu-cta" />
    </nav>
    <Cta
      kind="icon-primary"
      icon={{ name: 'menu', size: 'lg', kind: 'primary' }}
      className="toggle-menu-cta"
    />
  </div>
</header>

<script>
  function scrollToTheTop() {
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    });
  }

  const navLogo = document.getElementById('nav-logo');
  navLogo?.addEventListener('click', scrollToTheTop);

  function toggleMenu(e: Event) {
    const currentTarget = e.currentTarget as HTMLButtonElement;
    currentTarget?.classList.toggle('expanded');
    const menu = document.querySelector('.nav-menu');
    menu?.classList.toggle('expanded');
  }

  const menuCta = document.querySelector('.toggle-menu-cta');
  menuCta?.addEventListener('click', toggleMenu);
</script>
