---
import { footerContent } from '@content/footer';
import { Cta } from '@ui/cta';
import './footer.scss';

const { logo, links, personal, licence } = footerContent;
---

<footer class="footer">
  <div class="footer__logo-block">
    <h2 class="footer__logo">{logo.logoText}</h2>
    <p class="footer__tagline">{logo.tagline}</p>
  </div>
  <nav class="footer__nav">
    {
      links.map((link) => (
        <a class="footer__nav-link" href={link.href}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="footer__author">
    <h2 class="footer__author-name">{personal.fullName}</h2>
    <h3 class="footer__author-position">{personal.position}</h3>
    <nav class="footer__author-contacts">
      {personal.contacts.map((link) => (
      <Cta
        {...link}
        kind="link"
        icon={{ ...link.icon, size: 'sm', kind: 'primary' }}
        className="footer__author-contact"
      />
      ))}
    </nav>
  </div>
</footer>
<div class="footer__bottom">
  <p>© {new Date(Date.now()).getFullYear()} {logo.logoText}, {licence}</p>
  <ul>
    {
      personal.techStack.map((technology, i, arr) => (
        <li>
          <span>{technology}</span>
          {i !== arr.length - 1 && <span> · </span>}
        </li>
      ))
    }
  </ul>
</div>
