---
import { exposureCalculatorSectionContent as exposureSection } from '@content/exposure-calculator-section';
import { Section } from '@ui/section';
import ExposureCalculator from '@features/calculate-exposure/ui/exposure-calculator.astro';
---

<Section
  id={exposureSection.id}
  step={exposureSection.step}
  stepText={exposureSection.stepText}
  title={exposureSection.title}
  epigraph={exposureSection.epigraph}
>
  <ExposureCalculator
    slot="content"
    {...exposureSection.calculator}
  />
</Section>
