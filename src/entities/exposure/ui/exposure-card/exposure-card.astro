---
import type { ExposureCardProps } from './exposure-card.types';

const { title, description, step, theme = 'light', className } = Astro.props as ExposureCardProps;
---

<div class:list={["exposure-card", className]} data-theme={theme}>
  {step && <span class="exposure-card__step">{step}</span>}
  <div class="exposure-card__text-content">
    <h4 class="exposure-card__title">{title}</h4>
    <p class="exposure-card__details">{description}</p>
  </div>
</div>

<style lang="scss">
  .exposure-card {
    @include grid-layout(auto 1fr, auto, 24px);
    @include items-align(center, start);
    background: $bg-extra-light;
    border: 1px solid $border-50;
    padding: 28px 32px;
    color: $text-base-color;

    &__step {
      font-size: $text-xxl;
      font-weight: $text-regular;
      color: $accent;
      opacity: 0.35;
      line-height: $text-xxl--line-height;
      letter-spacing: 0.02em;
    }

    &__text-content {
      @include flex-layout(column, $row-gap: 8px);
      @include items-align(flex-start, center);
    }

    &__title {
      font-size: $text-base;
      font-weight: $text-semi-bold;
    }

    &__details {
      font-size: $text-xs;
      color: $text-muted;
      line-height: $text-xs--line-height;
    }

    &[data-theme='dark'] {
      background: $bg-main-dark;
      border-color: $bg-main-dark;
      color: $text-accent;

      .exposure-card {
        &__title {
          opacity: .5;
        }

        &__details {
          color: $text-accent;
        }
      }
    }
  }
</style>
