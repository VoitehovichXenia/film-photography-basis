---
import type { ExposureCardProps } from './exposure-card.types';

const { title, description, step, theme = 'light', className } = Astro.props as ExposureCardProps;
---

<div class:list={["exposure-card", className]} data-theme={theme}>
  {step && <span class="exposure-card__step">{step}</span>}
  <div class="exposure-card__text-content">
    <h4 class="exposure-card__title">{title}</h4>
    <p class="exposure-card__details">{description}</p>
  </div>
</div>

<style lang="scss">
  .exposure-card {
    @include grid-layout(auto 1fr, auto, 24px);
    align-items: center;
    justify-items: start;
    background: $white;
    border: 1px solid $gray-50;
    padding: 28px 32px;
    color: $black;

    &__step {
      font-size: $text-lg;
      font-weight: $text-regular;
      color: $accent;
      opacity: 0.35;
      line-height: $text-lg--line-height;
      letter-spacing: 0.02em;
    }

    &__text-content {
      @include flex-layout(flex-start, center, column, 0, 8px);
    }

    &__title {
      font-size: $text-base;
      font-weight: $text-semi-bold;
    }

    &__details {
      font-size: $text-xs;
      color: $gray-500;
      line-height: $text-xs--line-height;
    }

    &[data-theme='dark'] {
      background: $black;
      border-color: $black;
      color: $white;

      .exposure-card {
        &__title {
          opacity: .5;
        }

        &__details {
          color: $white;
        }
      }
    }
  }
</style>
