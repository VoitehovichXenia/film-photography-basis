---
import { type CtaProps, CtaIconKinds } from './cta.types';
import { Icon } from '@ui/icon';
import './cta.scss';

const { text, url, kind, icon, className } = Astro.props as CtaProps;

const iconKind = CtaIconKinds[kind] || CtaIconKinds.default;
const classList = ['cta', `cta__${kind}`, className];
---

{
  url 
  ? (
    <a class:list={classList} href={url}>
      {text}
      {icon && <Icon {...icon} kind={iconKind} />}
    </a>
  )
  : (
    <button class:list={classList}>
      {text}
      {icon && <Icon {...icon} kind={iconKind} />}
    </button>
  )
}